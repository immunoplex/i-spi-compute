# Copy this file to `.env` and replace each value with a generated secret.
#   cp .env.example .env
# Generate values with:  openssl rand -hex 32   (run once per secret)
#
# Do NOT commit .env. Keep this .env.example (no real values) as the template.

# API auth — clients send this as the X-API-Key header
API_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32

# PostgreSQL password for DB_USER — must MATCH the password in the database
DB_PASSWORD=REPLACE_ME_the_db_users_real_password

# Redis password — must MATCH redis-server --requirepass (same value in API + worker)
REDIS_AUTH=REPLACE_ME_generate_with_openssl_rand_hex_32
